{
  "name": "dsh-whale-pet-balance",
  "version": "0.2.6",
  "description": "DSH 桌面宠物（鲸鱼娘）+ DeepSeek 余额查看：右下角鲸鱼娘桌宠，右键查看余额/每轮花费/今日已用，支持拖拽、菜单、任务进度联动。基于 @asahimoon/dsh-desktop-pet 派生，集成 dsh-whale-widget 的余额与计费逻辑。",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "start": "electron main.js",
    "dev": "electron main.js --dev",
    "check": "node --check main.js && node --check preload.js && node --check index.mjs && node --check config.mjs && node --check renderer/core.js && node --check renderer/pet.js",
    "test": "vitest run",
    "dist": "electron-builder --win -p never",
    "dist:portable": "electron-builder --win portable -p never",
    "dist:mac": "electron-builder --mac -p never",
    "dist:linux": "electron-builder --linux -p never",
    "smoke:menu": "node scripts/smoke/smoke-menu.cjs",
    "smoke:pierce": "node scripts/smoke/smoke-pierce.cjs",
    "smoke:idle": "node scripts/smoke/smoke-idle.cjs",
    "smoke:drag": "node scripts/smoke/smoke-drag.cjs",
    "smoke:nap": "node scripts/smoke/smoke-nap.cjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desktop-pet",
    "electron",
    "pet",
    "whale-girl",
    "deepseek-balance",
    "balance",
    "codex-pet",
    "petdex",
    "tamagotchi"
  ],
  "author": "AsahiMoon <814256112@qq.com>",
  "contributors": [
    "dsh-whale-pet-balance contributors"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoju-1229/dsh-whale-pet-balance.git"
  },
  "homepage": "https://github.com/xiaoju-1229/dsh-whale-pet-balance#readme",
  "bugs": {
    "url": "https://github.com/xiaoju-1229/dsh-whale-pet-balance/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.mjs",
    "config.mjs",
    "main.js",
    "preload.js",
    "renderer/",
    "assets/characters/whale-girl/",
    "cordis.patch.yml",
    "docs/screenshot.png",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dependencies": {
    "koffi": "^3.1.5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.dsh.desktop-pet",
    "productName": "鲸鱼娘桌宠(纯桌宠版)",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "dsh-desktop-pet"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  }
}